# Byte-faithful machine-translated ASM -> C# override files.
#
# Files in this folder are exact ports of DNCDPRG.EXE routines reconstructed
# from the disassembly; fidelity to the original 8086 asm (operand order,
# sequential memory writes, explicit branch shapes) deliberately takes
# precedence over idiomatic C#. SonarAnalyzer / Meziantou style & quality
# rules (e.g. S4143 on distinct sequential UInt8[DS,..]= writes, S1940
# operator-preference, S3358 nested ternaries) therefore are not enforced
# here. Real compiler errors (CSxxxx) still fail the build.
#
# Scoped override of the solution-wide TreatWarningsAsErrors gate in
# src/Directory.Build.props (which remains in force for all hand-written
# engine code outside this folder).

[*.cs]
dotnet_analyzer_diagnostic.severity = none
